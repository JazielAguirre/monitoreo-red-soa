# Envía cualquier ruta de este servicio a index.php.

# Sin listado de archivos y sin redirección 301 a la URL con barra final:
# /servicios/SERVICIO y /servicios/SERVICIO/ llegan directo a index.php.
Options -Indexes
DirectorySlash Off

RewriteEngine On
# Necesario con DirectorySlash Off: sin esto mod_rewrite ignora la URL sin barra final.
RewriteOptions AllowNoSlash
# Todo va a index.php, también los archivos que existen (endpoints.php, escaneo.php, etc.):
# ningún otro archivo del servicio se ejecuta directamente por HTTP.
# No agregar RewriteCond %{REQUEST_FILENAME} !-f.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]
